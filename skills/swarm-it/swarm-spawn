#!/usr/bin/env bash
# swarm-spawn <label> <task-file> [--mode auto] [--model sonnet] [--path dir]
# One call per worker: split a pane, register it in the swarm rail, start a headless
# Claude on the task file. Prints <pane-id>:<label>, ready for swarm-wait. The result
# lands in ~/.kelpi-swarm/results/<label>.md.
set -euo pipefail

usage() { echo "usage: swarm-spawn <label> <task-file> [--mode auto] [--model sonnet] [--path dir]" >&2; exit 1; }
[ $# -ge 2 ] || usage
label=$1 task=$2; shift 2
mode=auto model=sonnet dir=$PWD
while [ $# -gt 0 ]; do
  case "$1" in
    --mode) mode=$2; shift 2 ;;
    --model) model=$2; shift 2 ;;
    --path) dir=$2; shift 2 ;;
    *) usage ;;
  esac
done

# Every value is typed into a shell, so only plain characters are allowed: no quotes, spaces, `$`, `;` or `..`.
bad() { echo "$1" >&2; exit 1; }
[[ $label =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && $label != *..* ]] || bad "label must be letters, digits, dot, dash or underscore"
[[ $mode =~ ^[A-Za-z]+$ && $model =~ ^[A-Za-z0-9.-]+$ ]] || bad "mode and model must be plain words"
[[ $task =~ ^[A-Za-z0-9._/~-]+$ && $dir =~ ^[A-Za-z0-9._/~-]+$ ]] || bad "task path and dir must be letters, digits, dot, dash, underscore or slash"
[ -f "$task" ] || { echo "no task file: $task" >&2; exit 1; }
task=$(cd "$(dirname "$task")" && pwd)/$(basename "$task")
[[ $task =~ ^[A-Za-z0-9._/~-]+$ ]] || bad "task path must be letters, digits, dot, dash, underscore or slash"
# The manifest records dir so swarm-retry can start the worker again: it must be absolute, with no `..`.
dir=$(cd "${dir/#\~/$HOME}" 2>/dev/null && pwd) || bad "no such directory: $dir"
[[ $dir =~ ^[A-Za-z0-9._/-]+$ ]] || bad "dir must be letters, digits, dot, dash, underscore or slash"

MW="$(dirname "$(realpath "$0")")/manifest-writer.mjs"
RES="$HOME/.kelpi-swarm/results"
mkdir -p "$RES/archive"
# Reusing a label keeps the old result under results/archive/ (the rail only reads results/<label>.md).
if [ -e "$RES/$label.md" ]; then
  mv -n "$RES/$label.md" "$RES/archive/$label.$(date -u +%Y%m%dT%H%M%SZ).md"
  [ ! -e "$RES/$label.md" ] || { echo "cannot archive the old result for $label" >&2; exit 1; }
fi

orch=$(kelpi pane id)
me=$(kelpi pane list --json | jq -c --arg p "$orch" '.[] | select(.id == $p)')
ws=$(jq -r '.workspace_id' <<<"$me")
# A swarm owns its Group: the rail and the hidden workers workspace both key off it.
[ "$(jq -r '.group_id // empty' <<<"$me")" ] || echo "warning: this workspace is not in a Group; the rail shows the swarm only here" >&2
node "$MW" show "$ws" >/dev/null 2>&1 || node "$MW" init "$ws" "$orch" coordinator >/dev/null
# A restarted coordinator gets a new pane id; the rail ignores a swarm whose coordinator pane is gone.
[ "$(node "$MW" show "$ws" | jq -r '.orchestrator.paneID')" = "$orch" ] || node "$MW" set-orchestrator "$ws" "$orch" >/dev/null
# Drop dead workers and dead swarms' manifests. After set-orchestrator, so a restarted coordinator keeps its own manifest.
kelpi pane list --json | node "$MW" prune --keep "$ws" >/dev/null 2>&1 || echo "warning: could not prune old swarm manifests" >&2
# Label the coordinator pane so it is easy to spot; never rename a pane the user already labelled.
[ "$(jq -r '.label // empty' <<<"$me")" ] || kelpi pane name --target "$orch" coordinator >/dev/null

# Open the worker straight in the shared `Workers` workspace when it exists: Kelpi switches the user's view
# on every move between workspaces, but never on a background create. Before it exists the worker splits
# here, and the plugin creates the Workers workspace and moves it there once.
workers=$(kelpi workspace list --json | jq -r --arg ws "$ws" \
  '([.[] | select(.name == "Workers" and .id != $ws and .group_name == "Workers")] + [.[] | select(.name == "Workers" and .id != $ws)])[0].id // empty')
if [ -n "$workers" ]; then
  pane=$(kelpi pane create --workspace "$workers" --name "$label" --path "$dir" --json | jq -r '.pane_id // .id')
else
  pane=$(kelpi pane split --name "$label" --path "$dir" --json | jq -r '.pane_id // .id')
fi
node "$MW" add-worker "$ws" "$pane" "$label" "$(head -1 "$task" | head -c 80)" "$RES/$label.md" \
  --task-path "$task" --model "$model" --mode "$mode" --dir "$dir" --started-at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >/dev/null

FORMAT="Write the result as markdown with three headings, ## Goal, ## Done and ## Next. Goal is one plain sentence saying what you were asked to do. Done is at most three short bullets saying what is now true or what you found, in plain words, with no code, file dumps or tool narration. Next is at most two bullets of what a human must decide or do, or the words Nothing pending. Keep the whole file under 80 words."

# Give the new shell a moment to draw its prompt before typing into it.
sleep 2
# cd explicitly: the split's --path did not reach the new shell in a live test.
kelpi pane send --target "$pane" "cd $dir && claude -p --permission-mode $mode --model $model \"Do the task in $task. $FORMAT Write the result to $RES/$label.md. Reply done.\"" >/dev/null
echo "$pane:$label"
