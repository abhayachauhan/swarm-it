#!/usr/bin/env bash
# swarm-spawn <label> <task-file> [--agent claude|codex] [--mode auto|on-request] [--model model] [--effort level] [--path dir] [--parent-session name]
# One call per worker: create a child workspace, register it in the swarm rail, start a headless
# agent on the task file. Prints <pane-id>:<label>, ready for swarm-wait. The result
# lands in ~/.kelpi-swarm/results/<label>.md.
# --parent-session names the coordinator's Claude Code session (the name ListAgents gives it). A Claude
# worker then messages the coordinator with SendMessage when it is blocked, finds something that changes
# the plan, and when it finishes. The result file is still written first, so swarm-wait remains the backstop.
# Every worker also appends heartbeat lines to results/<label>.status; swarm-status reads them.
set -euo pipefail

usage() { echo "usage: swarm-spawn <label> <task-file> [--agent claude|codex] [--mode mode] [--model model] [--effort low|medium|high|xhigh|max] [--path dir] [--parent-session name]" >&2; exit 1; }
[ $# -ge 2 ] || usage
label=$1 task=$2; shift 2
agent=claude mode= model= effort= dir=$PWD parent_session=
while [ $# -gt 0 ]; do
  case "$1" in
    --agent) agent=$2; shift 2 ;;
    --mode) mode=$2; shift 2 ;;
    --model) model=$2; shift 2 ;;
    --effort) effort=$2; shift 2 ;;
    --path) dir=$2; shift 2 ;;
    --parent-session) [ $# -ge 2 ] || usage; parent_session=$2; shift 2 ;;
    *) usage ;;
  esac
done
case "$agent" in
  claude) mode=${mode:-auto}; model=${model:-sonnet} ;;
  codex) mode=${mode:-on-request} ;;
  *) echo "agent must be claude or codex" >&2; exit 1 ;;
esac

# Every value is typed into a shell, so only plain characters are allowed: no quotes, spaces, `$`, `;` or `..`.
bad() { echo "$1" >&2; exit 1; }
[[ $label =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && $label != *..* ]] || bad "label must be letters, digits, dot, dash or underscore"
[[ $mode =~ ^[A-Za-z-]+$ && ( -z $model || $model =~ ^[A-Za-z0-9.-]+$ ) ]] || bad "mode and model must be plain words"
# The levels both CLIs accept. Codex's ultra is refused: it starts its own agents, so an unattended worker's cost is open-ended.
[[ -z $effort || $effort =~ ^(low|medium|high|xhigh|max)$ ]] || bad "effort must be low, medium, high, xhigh or max"
[[ -z $parent_session || ( $parent_session =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && $parent_session != *..* ) ]] || bad "parent session must be letters, digits, dot, dash or underscore"
if [ "$agent" = codex ]; then
  [[ $mode = on-request || $mode = never ]] || bad "Codex mode must be on-request or never"
fi
[[ $task =~ ^[A-Za-z0-9._/~-]+$ && $dir =~ ^[A-Za-z0-9._/~-]+$ ]] || bad "task path and dir must be letters, digits, dot, dash, underscore or slash"
[ -f "$task" ] || { echo "no task file: $task" >&2; exit 1; }
task=$(cd "$(dirname "$task")" && pwd)/$(basename "$task")
[[ $task =~ ^[A-Za-z0-9._/~-]+$ ]] || bad "task path must be letters, digits, dot, dash, underscore or slash"
# The manifest records dir so swarm-retry can start the worker again: it must be absolute, with no `..`.
dir=$(cd "${dir/#\~/$HOME}" 2>/dev/null && pwd) || bad "no such directory: $dir"
[[ $dir =~ ^[A-Za-z0-9._/-]+$ ]] || bad "dir must be letters, digits, dot, dash, underscore or slash"

MW="$(dirname "$(realpath "$0")")/manifest-writer.mjs"
RES="$HOME/.kelpi-swarm/results"

# A failed local socket call must not look like an empty workspace or archive an existing result.
orch=$(kelpi pane id) || bad "cannot identify the coordinator pane; run swarm-spawn from a Kelpi pane"
panes=$(kelpi pane list --json) || bad "cannot read Kelpi panes; if Codex denied local IPC, retry this command with sandbox escalation"
me=$(jq -ce --arg p "$orch" '.[] | select(.id == $p)' <<<"$panes") || bad "Kelpi returned no coordinator pane; check KELPI_PANE_ID and retry with sandbox escalation if local IPC was denied"
ws=$(jq -er '.workspace_id | select(type == "string" and length > 0)' <<<"$me") || bad "Kelpi returned no workspace ID for the coordinator; no worker was started"
[[ $ws =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && $ws != *..* ]] || bad "Kelpi returned an invalid workspace ID; no worker was started"
workspaces=$(kelpi workspace list --json) || bad "cannot read Kelpi workspaces; if Codex denied local IPC, retry this command with sandbox escalation"
[ -n "$workspaces" ] || bad "Kelpi returned no workspace list; no worker was started"
jq -e 'type == "array"' <<<"$workspaces" >/dev/null || bad "Kelpi returned an invalid workspace list; no worker was started"
# Kelpi supports one nesting level. A worker spawning more workers uses the same root parent.
parent=$(jq -r --arg ws "$ws" '.[] | select(.id == $ws) | .parent_id // .id' <<<"$workspaces")
[[ $parent =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && $parent != *..* ]] || bad "Kelpi returned no valid parent workspace; no worker was started"
node "$MW" show "$ws" >/dev/null 2>&1 || node "$MW" init "$ws" "$orch" coordinator >/dev/null
# A restarted coordinator gets a new pane id; the rail ignores a swarm whose coordinator pane is gone.
[ "$(node "$MW" show "$ws" | jq -r '.orchestrator.paneID')" = "$orch" ] || node "$MW" set-orchestrator "$ws" "$orch" >/dev/null
# Drop dead workers and dead swarms' manifests. After set-orchestrator, so a restarted coordinator keeps its own manifest.
printf '%s\n' "$panes" | node "$MW" prune --keep "$ws" >/dev/null 2>&1 || echo "warning: could not prune old swarm manifests" >&2
# Label the coordinator pane so it is easy to spot; never rename a pane the user already labelled.
[ "$(jq -r '.label // empty' <<<"$me")" ] || kelpi pane name --target "$orch" coordinator >/dev/null

# Check nesting support before creating anything on an older daemon.
kelpi workspace list --parent "$parent" --json >/dev/null || bad "Kelpi does not support child workspaces; update Kelpi before spawning workers"
created_ws= registered=0
cleanup_failed_spawn() {
  status=$?
  if [ "$status" -ne 0 ] && [ "$registered" = 0 ] && [ -n "$created_ws" ]; then
    kelpi workspace delete "$created_ws" >/dev/null 2>&1 || echo "warning: could not remove unused child workspace $created_ws" >&2
  fi
}
trap cleanup_failed_spawn EXIT
# A second worker under a label whose agent still runs would share its result and status files.
dup=$(node "$MW" show "$ws" | jq --argjson panes "$panes" --arg l "$label" '[.workers[] | select(.label == $l) | .paneID] as $ids | [$panes[] | select(.id as $i | $ids | index($i)) | select(.status == "running" or .status == "waitingForInput" or ((.agent_session_id // "") != ""))] | length') || bad "cannot read the swarm manifest"
[ "$dup" = 0 ] || bad "a worker named $label is still running; wait for it or pick another label"
# Each worker owns the first shell of its own child workspace, created without changing focus.
child=$(kelpi workspace create --parent "$parent" --name "$label" --path "$dir" --no-repo --json) || bad "Kelpi did not create the child workspace; no worker was registered"
created_ws=$(jq -r '.workspace_id // empty' <<<"$child")
[[ $created_ws =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && $created_ws != *..* ]] || { created_ws=; bad "Kelpi returned no valid child workspace ID"; }
worker_ws=$(jq -er --arg parent "$parent" 'select(.parent_id == $parent) | .workspace_id | select(type == "string" and length > 0)' <<<"$child") || bad "Kelpi did not nest the child workspace; update Kelpi before spawning workers"
pane=
for attempt in 1 2 3; do
  pane=$(kelpi pane list --workspace "$worker_ws" --json | jq -er 'if length == 1 then .[0].id | select(type == "string" and length > 0) else error("expected one initial shell") end') && break
  sleep 0.2
done
[ -n "$pane" ] || bad "Kelpi did not create the worker pane; no worker was registered"
kelpi pane name --target "$pane" "$label" >/dev/null
mkdir -p "$RES/archive"
# Reusing a label keeps the old result under results/archive/ (the rail only reads results/<label>.md).
if [ -e "$RES/$label.md" ]; then
  mv -n "$RES/$label.md" "$RES/archive/$label.$(date -u +%Y%m%dT%H%M%SZ).md"
  [ ! -e "$RES/$label.md" ] || { echo "cannot archive the old result for $label" >&2; exit 1; }
fi
started=$(date -u +%Y-%m-%dT%H:%M:%SZ)
# First heartbeat line, written here so swarm-status can tell a worker that never started from a slow one.
# It replaces a reused label's old file, so the last worker's done line is never read as this one's.
# Before registering, so a failed write leaves no worker that never started.
rm -f -- "$RES/$label.status"
# noclobber: refuse to write through anything that appears at the path between the rm and the write.
( set -C; printf '%s spawned\n' "$started" >"$RES/$label.status" ) || bad "cannot write the status file for $label"
node "$MW" add-worker "$ws" "$pane" "$label" "$(head -1 "$task" | head -c 80)" "$RES/$label.md" \
  --agent "$agent" --task-path "$task" --model "${model:--}" --mode "$mode" --effort "${effort:--}" --dir "$dir" --started-at "$started" >/dev/null
registered=1

FORMAT="Write the result as markdown with three headings, ## Goal, ## Done and ## Next. Goal is one plain sentence saying what you were asked to do. Done is at most three short bullets saying what is now true or what you found, in plain words, with no code, file dumps or tool narration. Next is at most two bullets of what a human must decide or do, or the words Nothing pending. Keep the whole file under 80 words."

# Both agents get this one. Workers are one-shot, so the status file is the only sign of life before the result.
HEARTBEAT="Keep a heartbeat in $RES/$label.status: append one line per state change with one shell command, echo \"\$(date -u +%Y-%m-%dT%H:%M:%SZ) working: <short what>\" >> $RES/$label.status. The text after the time is started, working: <short what>, pr-open: #123 <sha>, blocked: <why> or done. Write at most one line every few minutes, but a working: line at least every 15 minutes during long work. Append, never overwrite. Write the final done line last, after the result file."

report=
if [ "$agent" = claude ]; then
  [ -z "$parent_session" ] || report=" Your coordinator is the Claude Code session $parent_session. Load SendMessage with ToolSearch query select:SendMessage, then send it one-line messages that start with $label: when you are blocked, when you find something that changes the plan, and once at the very end after the result file is written, saying done and the result path. Never send more than one message a minute, and never send to any other session. Always write the result file even if a send fails."
else
  # Codex has no SendMessage: its result file and swarm-wait are the only report.
  [ -z "$parent_session" ] || echo "note: Codex workers cannot message $parent_session; rely on swarm-wait" >&2
fi
# The prompt goes in a file and the typed command reads it. A line typed before the new shell's line
# editor starts is cut at the terminal's 1024-byte limit (macOS MAX_CANON), which left a long prompt
# with no closing quote and the worker never started (2026-11-24).
# One file per spawn, so two spawns that share a label cannot swap prompts before their shells start.
PROMPTS="$HOME/.kelpi-swarm/prompts"
mkdir -p "$PROMPTS"
find "$PROMPTS" -name '*.txt' -mtime +1 -delete 2>/dev/null || true
promptFile=$(mktemp "$PROMPTS/$label.XXXXXX") || bad "cannot write the worker prompt file"
mv "$promptFile" "$promptFile.txt" && promptFile=$promptFile.txt
[[ $promptFile != *"'"* ]] || bad "the prompt file path cannot contain a single quote"
printf '%s\n' "Do the task in $task. $FORMAT Write the result to $RES/$label.md. $HEARTBEAT${report} Reply done." >"$promptFile"
# Single-quoted so a home folder with spaces still reaches cat as one argument.
prompt="\"\$(cat '$promptFile')\""

# Give the new shell a moment to draw its prompt before typing into it.
sleep 2
# cd explicitly: the split's --path did not reach the new shell in a live test.
if [ "$agent" = claude ]; then
  effortArg=
  [ -z "$effort" ] || effortArg="--effort $effort "
  kelpi pane send --target "$pane" "cd $dir && claude -p --permission-mode $mode --model $model ${effortArg}${prompt}" >/dev/null
else
  modelArg= effortArg=
  [ -z "$model" ] || modelArg="--model $model "
  [ -z "$effort" ] || effortArg="-c model_reasoning_effort=$effort "
  kelpi pane send --target "$pane" "cd $dir && codex --sandbox workspace-write --add-dir $RES --ask-for-approval $mode ${modelArg}${effortArg}${prompt}" >/dev/null
fi
echo "$pane:$label"
