#!/usr/bin/env bash
# swarm-send <pane-id>:<label> <task-file> [--confirm-seconds N]
# Send a follow-up task to a live, idle worker of this coordinator's swarm. Nothing is typed unless the pane
# exists, its agent is alive, no turn is running, it is not waiting on a person, and the screen shows the
# agent's own input line. The old result is archived first, so swarm-wait sees the new one as new.
# Prints <pane-id>:<label> once the turn is seen to start. With no proof after N seconds (default 20) it
# prints NOT-STARTED <pane-id>:<label> and the pane's last lines, and exits 2. It never sends twice: the
# text may still have arrived, so look at the pane before deciding. Exit 1 means nothing was typed.
set -euo pipefail

usage() { echo "usage: swarm-send <pane-id>:<label> <task-file> [--confirm-seconds N]" >&2; exit 1; }
bad() { echo "$1" >&2; exit 1; }
[ $# -ge 2 ] || usage
worker=$1 task=$2; shift 2
confirm=20
while [ $# -gt 0 ]; do
  case "$1" in
    --confirm-seconds) [ $# -ge 2 ] || usage; confirm=$2; shift 2 ;;
    *) usage ;;
  esac
done
[[ $confirm =~ ^[0-9]+$ ]] || bad "--confirm-seconds must be a whole number of seconds"
[[ $worker == *:* ]] || usage
pane=${worker%%:*} label=${worker#*:}

# Same character rules as swarm-spawn.
[[ $pane =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && $pane != *..* ]] || bad "pane id must be letters, digits, dot, dash or underscore"
[[ $label =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && $label != *..* ]] || bad "label must be letters, digits, dot, dash or underscore"
[[ $task =~ ^[A-Za-z0-9._/~-]+$ ]] || bad "task path must be letters, digits, dot, dash, underscore or slash"
[ -f "$task" ] || bad "no task file: $task"
task=$(cd "$(dirname "$task")" && pwd)/$(basename "$task")
[[ $task =~ ^[A-Za-z0-9._/~-]+$ ]] || bad "task path must be letters, digits, dot, dash, underscore or slash"

HERE="$(dirname "$(realpath "$0")")"
MW="$HERE/manifest-writer.mjs"
RES="$HOME/.kelpi-swarm/results"
MDIR="${SWARM_MANIFEST_DIR:-$HOME/.kelpi-swarm}"
NEWS="$MDIR/news/$pane.jsonl"
STATUS="$RES/$label.status"
. "$HERE/swarm-lib.sh"

orch=$(kelpi pane id) || bad "cannot identify the coordinator pane; run swarm-send from a Kelpi pane"
panes=$(kelpi pane list --json) || bad "cannot read Kelpi panes; if Codex denied local IPC, retry this command with sandbox escalation"
ws=$(jq -er --arg p "$orch" '.[] | select(.id == $p) | .workspace_id | select(type == "string" and length > 0)' <<<"$panes") || bad "Kelpi returned no workspace ID; check KELPI_PANE_ID and retry with sandbox escalation if local IPC was denied"
manifest=$(node "$MW" show "$ws") || bad "no swarm manifest for this workspace"
# Only a worker of this swarm: never the coordinator or any other pane.
rec=$(jq -c --arg p "$pane" --arg l "$label" '.workers[] | select(.paneID == $p and .label == $l)' <<<"$manifest")
[ -n "$rec" ] || bad "no worker $pane:$label in this swarm's manifest"
[ "$pane" != "$orch" ] || bad "pane $pane is the coordinator, not a worker"
agent=$(jq -r '.agent // "claude"' <<<"$rec")
[[ $agent = claude || $agent = codex ]] || bad "recorded agent must be claude or codex"

state=$(jq -c --arg p "$pane" '[.[] | select(.id == $p)][0] // empty' <<<"$panes")
[ -n "$state" ] || bad "pane $pane is gone; start the worker again with swarm-retry $pane:$label"
status=$(jq -r '.status // empty' <<<"$state")
session=$(jq -r '.agent_session_id // empty' <<<"$state")
dead="no live agent in pane $pane; start the worker again with swarm-retry $pane:$label"
[[ $status = running || $status = waitingForInput || -n $session ]] || bad "$dead"
[ ! -s "$MDIR/exits/$pane.json" ] || bad "$dead"
[ "$status" != running ] || bad "worker $label is in the middle of a turn; wait for it to finish"

# The newer of the last blocked and turn-done lines wins; the file is append-only, so line order is time order.
if [ -f "$NEWS" ]; then
  waiting=$(jq -rRn '[inputs | fromjson? | objects | .kind | select(. == "blocked" or . == "turn-done")] | last // empty' "$NEWS") || bad "cannot read the news file for $label"
  [ "$waiting" != blocked ] || bad "worker $label is waiting on a person; answer it in pane $pane first"
fi

# Kelpi's status and session id go stale when an agent dies without telling it, and an idle composer can
# read as waitingForInput, so the screen decides: text typed into a shell would run as a command, and
# Enter on a permission menu means Yes.
screen=$(kelpi pane capture --target "$pane" --lines 40) || bad "cannot read pane $pane; nothing was typed"
# The escape sequences go, then blank lines.
lines=$(sed $'s/\x1b\\[[0-9;?]*[ -\\/]*[@-~]//g' <<<"$screen" | grep -v '^[[:space:]]*$' || true)
! grep -qi 'esc to interrupt' <<<"$(tail -n 8 <<<"$lines")" || bad "worker $label is in the middle of a turn; wait for it to finish"
# Claude's input box: a full-width rule, the ❯ line (not a menu's "❯ 1. Yes"), a closing rule and at most
# 4 status lines below it. The same test as the rail's send (backend/actions.mjs).
claude_input() {
  local -a l=()
  local line i k n
  while IFS= read -r line; do l+=("$line"); done <<<"$lines"
  n=${#l[@]}
  local rule='^[[:space:]]*(─|━){20,}[[:space:]]*$'
  # Claude may follow ❯ with a no-break space, which [[:space:]] does not match in every locale.
  local gap=$'([[:space:]]|\xc2\xa0)'
  local prompt="^[[:space:]]*❯($gap|\$)" menu="^[[:space:]]*❯$gap*[0-9]+[.)]$gap"
  for ((i = n - 1; i > 0; i--)); do
    [[ ${l[i]} =~ $prompt ]] || continue
    [[ ! ${l[i]} =~ $menu ]] || continue
    [[ ${l[i - 1]} =~ $rule ]] || continue
    for ((k = i + 1; k < n; k++)); do
      [[ ! ${l[k]} =~ $rule ]] || { ((n - 1 - k <= 4)); return; }
    done
    return 1
  done
  return 1
}
# Codex draws its composer as a › line near the bottom; an approval or question menu uses › on numbered rows.
codex_input() {
  local bottom
  bottom=$(tail -n 8 <<<"$lines")
  ! grep -qE '^[[:space:]]*(›[[:space:]]*)?[0-9]+[.)][[:space:]]' <<<"$bottom" && grep -qE '^[[:space:]]*›([[:space:]]|$)' <<<"$bottom"
}
"${agent}_input" || bad "pane $pane does not show the ${agent^} input line (a permission prompt, a menu or a shell); nothing was typed"

report=
[ "$agent" != claude ] || report=" If you were told to message a coordinator session, do so for this task too."
worker_instructions
write_prompt "Follow-up task for you, the same worker. Do the task in $task. $FORMAT Write the new result to $RES/$label.md (the previous one was archived). $HEARTBEAT$report Reply done." || bad "cannot write the follow-up prompt file"
archive_result || bad "cannot archive the old result for $label; nothing was typed"

# A new line, so swarm-status does not keep reading the last task's done line. Never through a symlink.
[ ! -L "$STATUS" ] || bad "the status file for $label is a symlink; nothing was typed"
printf '%s follow-up sent\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >>"$STATUS" || bad "cannot write the status file for $label; nothing was typed"

beats=$(wc -l <"$STATUS")
# News is compared by time, not by line count: the writer may drop old lines to cap the file.
# newer_than <key>: prints the latest key among news lines after <key>, exited lines aside.
newer_than() {
  [ -f "$NEWS" ] || return 0
  jq -rRn --arg after "$1" "$NEWS_KEY"'
    [inputs | fromjson? | objects | select(.kind != "exited") | .at | key | select(. > $after)] | max // empty' "$NEWS" 2>/dev/null || true
}
news=$(newer_than "")

not_started() {
  echo "NOT-STARTED $pane:$label${1:+ $1}"
  kelpi pane capture --target "$pane" --lines 10 || true
  exit 2
}
# Starts with a word no shell has as a command, in case the agent ended between the check and now.
kelpi pane send --target "$pane" "Follow-up: read the file $promptFile and do what it says." >/dev/null || not_started "(kelpi pane send failed)"

# Proof that the turn started: the pane is running, or a new heartbeat or news line appeared. An exited
# line is the opposite of proof.
for ((t = 0; ; t++)); do
  now=$(kelpi pane list --json 2>/dev/null | jq -r --arg p "$pane" '.[] | select(.id == $p) | .status // empty' || true)
  if [ "$now" = running ] || [ "$(wc -l <"$STATUS")" -gt "$beats" ] || [ -s "$RES/$label.md" ] || [ -n "$(newer_than "$news")" ]; then
    echo "$pane:$label"
    exit 0
  fi
  [ "$t" -lt "$confirm" ] || break
  sleep 1
done
not_started
