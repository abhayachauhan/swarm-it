{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "local.swarm-view/manifest",
  "title": "Swarm manifest (~/.kelpi-swarm/<workspace-id>.json)",
  "type": "object",
  "required": ["version", "orchestrator", "workers"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "orchestrator": {
      "type": "object",
      "required": ["paneID", "label"],
      "additionalProperties": false,
      "properties": {
        "paneID": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "workers": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["paneID", "label", "task", "resultPath", "worktreePath", "parent"],
        "additionalProperties": false,
        "properties": {
          "paneID": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "task": { "type": "string", "maxLength": 1000 },
          "resultPath": { "type": ["string", "null"] },
          "worktreePath": { "type": ["string", "null"] },
          "parent": { "type": ["string", "null"] },
          "agent": { "enum": ["claude", "codex"] },
          "taskPath": { "type": ["string", "null"], "maxLength": 1000 },
          "model": { "type": ["string", "null"], "maxLength": 40 },
          "mode": { "type": ["string", "null"], "maxLength": 40 },
          "effort": { "enum": ["low", "medium", "high", "xhigh", "max", null] },
          "dir": { "type": ["string", "null"], "maxLength": 1000 },
          "startedAt": { "type": ["string", "null"], "maxLength": 40, "format": "date-time" }
        }
      }
    }
  }
}
